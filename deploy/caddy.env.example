# Environment for the Caddy frontend server (systemd EnvironmentFile).
# Copy to deploy/caddy.env on the server (it is git-ignored) and restrict access:
#   cp deploy/caddy.env.example deploy/caddy.env && chmod 600 deploy/caddy.env
# Plain KEY=value lines, no `export`, no quotes.

# Base64 of "<elasticsearch user>:<password>", sent as Basic auth to Elasticsearch.
# Generate with:
#   printf '%s' 'elastic:<password>' | base64
ES_BASIC_AUTH=<base64 of user:password>
