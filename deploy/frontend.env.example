# Build-time settings for the production frontend.
#
# vue-cli bakes VUE_APP_* variables into the JavaScript bundle at `npm run build`,
# so they are public and must never contain secrets. Copy this file to
# .env.production.local in the repository root on the server (git-ignored), then
# rebuild:
#   cp deploy/frontend.env.example .env.production.local && npm run build
#
# All URLs are relative: Caddy (deploy/Caddyfile) proxies them on the same origin.

VUE_APP_I18N_LOCALE=de
VUE_APP_I18N_FALLBACK_LOCALE=fr

# Query embeddings: big chunks (Qwen3-Embedding-8B) and micro chunks (Qwen3-Embedding-0.6B).
# The model names must match --served-model-name of the vLLM services.
VUE_APP_EMBED_BIG_API_URL=/api/embed/big
VUE_APP_EMBED_BIG_MODEL=qwen3-embedding-8b
VUE_APP_EMBED_MICRO_API_URL=/api/embed/micro
VUE_APP_EMBED_MICRO_MODEL=qwen3-embedding-0.6b

# Must match EMBED_BIG_INDEX / EMBED_MICRO_INDEX in the feeder's .env.
VUE_APP_EMBEDDING_SEARCH_URL=/api/elasticsearch/embeddings_qwen3-embedding-8b/_search
VUE_APP_EMBEDDING_MICRO_SEARCH_URL=/api/elasticsearch/embeddings_qwen3-embedding-0.6b_micro/_search
VUE_APP_SEARCH_URL=/api/elasticsearch/_search
VUE_APP_INDEX_MICRO_CHUNK_URL=/api/indexMicroChunk
